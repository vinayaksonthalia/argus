#!/usr/bin/env python3
"""faultctl — inject and clear faults in the Faultline demo stack.

    faultctl list
    faultctl inject slow-query        # catalog: pg_sleep(2.5) in product SELECT
    faultctl inject error-storm       # payments: 30% of charges return 502
    faultctl inject memory-pressure   # orders: ~1MB leaked per request
    faultctl inject bad-deploy        # orders: deploy event + slow/flaky handling
    faultctl clear <fault>|all

Stdlib only — no venv needed.
"""

from __future__ import annotations

import json
import sys
import urllib.error
import urllib.request

FAULT_HOSTS = {
    "slow-query": "http://localhost:8091",       # catalog
    "error-storm": "http://localhost:8092",      # payments
    "memory-pressure": "http://localhost:8093",  # orders
    "bad-deploy": "http://localhost:8093",       # orders
}

GREEN, RED, AMBER, DIM, RESET = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"


def _call(url: str, method: str = "GET") -> dict:
    req = urllib.request.Request(url, method=method)
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.loads(resp.read())


def do_list() -> int:
    seen: dict[str, tuple[str, bool]] = {}
    for fault, host in FAULT_HOSTS.items():
        try:
            state = _call(f"{host}/_fault")
            seen[fault] = (host, bool(state.get(fault)))
        except (urllib.error.URLError, OSError):
            print(f"{RED}✗{RESET} {fault:<16} {DIM}{host} unreachable{RESET}")
            continue
    for fault, (host, active) in seen.items():
        dot = f"{RED}●{RESET} ACTIVE " if active else f"{GREEN}●{RESET} idle   "
        print(f"{dot} {fault:<16} {DIM}{host}{RESET}")
    return 0


def do_set(fault: str, action: str) -> int:
    targets = list(FAULT_HOSTS) if fault == "all" else [fault]
    rc = 0
    for f in targets:
        host = FAULT_HOSTS.get(f)
        if not host:
            print(f"{RED}unknown fault '{f}'{RESET} (known: {', '.join(FAULT_HOSTS)})",
                  file=sys.stderr)
            return 2
        try:
            _call(f"{host}/_fault/{f}/{action}", method="POST")
            color = AMBER if action == "on" else GREEN
            print(f"{color}{'INJECTED' if action == 'on' else 'cleared'}{RESET} {f} @ {host}")
        except (urllib.error.URLError, OSError) as exc:
            print(f"{RED}failed{RESET} {f}: {exc}", file=sys.stderr)
            rc = 1
    return rc


def main(argv: list[str]) -> int:
    if len(argv) >= 1 and argv[0] == "list":
        return do_list()
    if len(argv) == 2 and argv[0] in ("inject", "clear"):
        return do_set(argv[1], "on" if argv[0] == "inject" else "off")
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
