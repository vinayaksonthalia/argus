# ARGUS configuration — copy to .env and fill in REAL values.
# Startup refuses to run live mode with placeholder-looking secrets.
# Replay mode (argus investigate --replay / argus eval / pytest) needs none of these.

# SigNoz
SIGNOZ_URL=http://localhost:8080
SIGNOZ_API_KEY=your-signoz-api-key

# LLM provider: auto | anthropic | claude-cli | heuristic
#   auto        -> anthropic if ANTHROPIC_API_KEY is set, else claude-cli if the
#                  `claude` CLI (Claude Code, subscription auth) is installed,
#                  else the deterministic heuristic fallback.
#   claude-cli  -> live Claude through the local `claude` CLI (no API key needed)
#   heuristic   -> rule-based, zero-LLM (for pipeline testing; clearly labeled)
ARGUS_LLM_PROVIDER=auto
# Only needed for the 'anthropic' SDK provider:
ANTHROPIC_API_KEY=your-anthropic-api-key
ARGUS_MODEL=claude-sonnet-4-5
# Free-tier OpenAI-compatible fallbacks (demo resilience; cost recorded as $0):
GROQ_API_KEY=
ARGUS_GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
ARGUS_CEREBRAS_MODEL=gpt-oss-120b

# Slack (optional — omit for dry-run: blocks are logged instead of posted)
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_CHANNEL=#incidents

# Self-observation (optional — leave empty to disable OTLP export)
# Point at SigNoz's OTLP HTTP endpoint to trace ARGUS into SigNoz itself.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=argus

# Server
ARGUS_PORT=7331
ARGUS_MAX_ITERATIONS=2

# Incident memory (SQLite + local hashed-TF embeddings — no paid APIs).
# Completed investigations are stored and similar past incidents are recalled
# into new RCAs. Set to "off" to disable.
ARGUS_MEMORY_DB=argus-memory.sqlite3

# SigNoz read transport: rest (default) | mcp
# mcp routes every read through the SigNoz MCP server's
# signoz_execute_builder_query tool (JSON-RPC) instead of /api/v5/query_range.
ARGUS_TRANSPORT=rest
ARGUS_MCP_URL=http://localhost:8000/mcp
